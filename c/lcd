#define SPI_DMA_THRESHOLDS ((0x20 << 24) | (0x10 << 16) | (0x10 << 8) | 0x20)

#define MADCTL_MY  0x80
#define MADCTL_MV  0x20
#define MADCTL_BGR 0x08

#define COLMOD_65K_RGB 0x50
#define COLMOD_16BPP   0x05

#define DMA_CHANNEL_OFFSET 0x100
#define DMA_REG_CS         0x00
#define DMA_REG_CONBLK_AD  0x04
#define DMA_REG_TXFR_LEN   0x14
#define DMA_REG_DEBUG      0x20
#define DMA_REG_ENABLE     0xFF0

#define DMA_CS_ACTIVE                    (1u << 0)
#define DMA_CS_END                       (1u << 1)
#define DMA_CS_INT                       (1u << 2)
#define DMA_CS_DREQ                      (1u << 3)
#define DMA_CS_PAUSED                    (1u << 4)
#define DMA_CS_ERROR                     (1u << 8)
#define DMA_CS_WAIT_FOR_OUTSTANDING_WRITES (1u << 28)
#define DMA_CS_ABORT                     (1u << 30)
#define DMA_CS_RESET                     (1u << 31)

#define DMA_TI_INTEN          (1u << 0)
#define DMA_TI_TDMODE         (1u << 1)
#define DMA_TI_WAIT_RESP      (1u << 3)
#define DMA_TI_DEST_INC       (1u << 4)
#define DMA_TI_DEST_WIDTH     (1u << 5)
#define DMA_TI_DEST_DREQ      (1u << 6)
#define DMA_TI_DEST_IGNORE    (1u << 7)
#define DMA_TI_SRC_INC        (1u << 8)
#define DMA_TI_SRC_WIDTH      (1u << 9)
#define DMA_TI_SRC_DREQ       (1u << 10)
#define DMA_TI_SRC_IGNORE     (1u << 11)
#define DMA_TI_NO_WIDE_BURSTS (1u << 26)
#define DMA_TI_PERMAP_SHIFT   16
#define DMA_TI_WAITS_SHIFT    21
#define DMA_DEBUG_CLEAR 0x7
#define DMA_PRIORITY    (8u << 16)
#define DMA_PANIC_PRIORITY (8u << 20)
#define DMA_FRAME_SIZE_BYTES DMA_BUFFER_SIZE
#define DMA_SPI_MAX_TRANSFER 65532u
#define DMA_SPI_MAX_CHUNKS 8
#define DMA_CB_MAX_TRANSFER 0xFFFFu /* DMA control block txfr_len limit (64k) */

#define DMA_SPI_CHUNK_COUNT \
    ((DMA_FRAME_SIZE_BYTES + DMA_SPI_MAX_TRANSFER - 1) / DMA_SPI_MAX_TRANSFER)

#define DMA_SPI_TX_DREQ 6u
#define DMA_SPI_RX_DREQ 7u

typedef struct dma_control_block {
    unsigned int transfer_info;
    unsigned int source_ad;
    unsigned int dest_ad;
    unsigned int txfr_len;
    unsigned int stride;
    unsigned int nextconbk;
    unsigned int reserved0;
    unsigned int reserved1;
} dma_control_block_t;

/* The DMA-able buffer. Currently obtained with PCI_RAMAlloc. The tx, rx and cb
 * struture members will be setup to point to the relavant offsets on creation.
 */
typedef struct dma_buffer {
  struct {
    void    *logical;
    uint32_t physical;
  } tx, rx, cb;
} dma_buffer_t;

_kernel_oserror *create_buffer(dma_buffer_t* buffer)
{
    const unsigned screen_bytes = SCREEN_WIDTH*SCREEN_HEIGHT*SCREEN_DEPTH;
    _kernel_oserror *e;

    e = _swix(PCI_RAMAlloc, _INR(0,2)|_OUTR(0,1),
        (screen_bytes * 2) +
        (sizeof(dma_control_block_t) * DMA_MAX_CONTROL_BLOCKS),
        0x1000, 0,
        &buffer->tx.logical, &buffer->tx.physical);

    if (e)
        return e;

    buffer->rx.logical = (char*)buffer->tx.logical+screen_bytes;
    buffer->cb.logical = (char*)buffer->rx.logical+screen_bytes;

    buffer->rx.physical = buffer->tx.physical+screen_bytes;
    buffer->cb.physical = buffer->rx.physical+screen_bytes;

    return 0;
}

_kernel_oserror *remove_buffer(dma_buffer_t* buffer)
{
   return _swix(PCI_RAMFree, _IN(0), buffer->tx.logical);
}

static _kernel_oserror lcddisplay_lcd_error;

static _kernel_oserror *lcddisplay_make_lcd_error(const char *text)
{
    lcddisplay_lcd_error.errnum = 0x82ec01;
    strncpy(lcddisplay_lcd_error.errmess, text,
            sizeof(lcddisplay_lcd_error.errmess) - 1);
    lcddisplay_lcd_error.errmess[sizeof(lcddisplay_lcd_error.errmess) - 1] = '\0';
    return &lcddisplay_lcd_error;
}

static volatile unsigned int *dma_channel_regs(unsigned int channel)
{
    return (volatile unsigned int *)
        ((char *)dma_base + (channel * DMA_CHANNEL_OFFSET));
}

static void dma_reset_channel(unsigned int channel){
    volatile unsigned int *regs = dma_channel_regs(channel);

    regs[DMA_REG_CS / 4] = DMA_CS_RESET;
    regs[DMA_REG_DEBUG / 4] = DMA_DEBUG_CLEAR;
    regs[DMA_REG_CS / 4] = DMA_CS_END | /*DMA_CS_INT |*/ DMA_CS_ERROR;
    regs[DMA_REG_CONBLK_AD / 4] = 0;
}

static void dma_log_transfer_status(volatile unsigned int *spi,
                                    volatile unsigned int *tx_regs,
                                    volatile unsigned int *rx_regs)
{
    printf("SPI DMA status: ENABLE=%08x SPI CS=%08x; "
           "TX CS=%08x CB=%08x LEN=%08x DEBUG=%08x; "
           "RX CS=%08x CB=%08x LEN=%08x DEBUG=%08x\n",
           dma_base[DMA_REG_ENABLE / 4],
           spi[SPI_CS_REG / 4],
           tx_regs[DMA_REG_CS / 4],
           tx_regs[DMA_REG_CONBLK_AD / 4],
           tx_regs[DMA_REG_TXFR_LEN / 4],
           tx_regs[DMA_REG_DEBUG / 4],
           rx_regs[DMA_REG_CS / 4],
           rx_regs[DMA_REG_CONBLK_AD / 4],
           rx_regs[DMA_REG_TXFR_LEN / 4],
           rx_regs[DMA_REG_DEBUG / 4]);
}

static void dma_build_control_block(dma_buffer_t *buffer,
                                    unsigned int offset, unsigned int length,
                                    unsigned int fifo_address, int is_tx,
                                    dma_control_block_t *cb)
{
    unsigned int transfer_info;

    transfer_info = DMA_TI_NO_WIDE_BURSTS | DMA_TI_WAIT_RESP
                  | (is_tx ? (DMA_TI_SRC_INC  | DMA_TI_DEST_DREQ)
                           : (DMA_TI_DEST_INC | DMA_TI_SRC_DREQ ))
                  | ((is_tx ? DMA_SPI_TX_DREQ : DMA_SPI_RX_DREQ)
                     << DMA_TI_PERMAP_SHIFT);

    cb->transfer_info = transfer_info;
    if (is_tx) {
        cb->source_ad = (0xc0000000 | (buffer->tx.physical)) + offset;
        cb->dest_ad   = fifo_address;
    } else {
        cb->source_ad = fifo_address;
        cb->dest_ad   = (0xc0000000 | (buffer->rx.physical)) + offset;
    }
    cb->txfr_len  = length;
    cb->stride    = 0;
    cb->nextconbk = 0;
    cb->reserved0 = 0;
    cb->reserved1 = 0;

    // printf("  %d bytes from %p to %p\n", cb->txfr_len, (void*)cb->source_ad, (void*)cb->dest_ad);
}

typedef struct dma_transfer_chunk {
    unsigned int length;
    unsigned     tx_cb_physical;
    unsigned     rx_cb_physical;
} dma_transfer_chunk_t;

static _kernel_oserror *dma_build_chunks(
    dma_buffer_t *buffer, dma_transfer_chunk_t *chunks, unsigned *chunk_count)
{
    unsigned int offset;
    unsigned int cb_count = 0;

    unsigned total = SCREEN_WIDTH * SCREEN_HEIGHT * SCREEN_DEPTH;

    for (offset = 0; offset < total; (*chunk_count)++) {
        unsigned int length = total - offset;

        if (*chunk_count >= DMA_SPI_MAX_CHUNKS)
            return lcddisplay_make_lcd_error("Too many SPI DMA chunks");

        if (length > DMA_SPI_MAX_TRANSFER)
            length = DMA_SPI_MAX_TRANSFER;

//        printf("transfer %d bytes from offset %d\n", length, offset);

        chunks[*chunk_count].tx_cb_physical =
            buffer->cb.physical + (cb_count * sizeof(dma_control_block_t));

        dma_build_control_block(
            buffer, offset, length,
            SPI_BUS_BASE + SPI_FIFO_REG, true,
            &((dma_control_block_t*)(buffer->cb.logical))[cb_count++]);

        chunks[*chunk_count].rx_cb_physical =
            buffer->cb.physical + (cb_count * sizeof(dma_control_block_t));

        dma_build_control_block(
            buffer, offset, length,
            SPI_BUS_BASE + SPI_FIFO_REG, false,
            &((dma_control_block_t*)(buffer->cb.logical))[cb_count++]);

        chunks[*chunk_count].length = length;

/*
        transfer->rx_cb_offsets[transfer->chunk_count] =
            transfer->control_block_count + 1;
        transfer->transfer_lengths[transfer->chunk_count] = length;
        transfer->control_block_count += 2;
*/
        if (cb_count > DMA_MAX_CONTROL_BLOCKS)
            return lcddisplay_make_lcd_error("Too many DMA control blocks");

        offset += length;
    }

    return NULL;
}

static _kernel_oserror *dma_run_chunk(const dma_transfer_chunk_t *chunk)
{
    // printf("dma_run_chunk %d\n", chunk_index);
    volatile unsigned int *spi = (volatile unsigned int *) spi_base;
    volatile unsigned int *tx_regs = dma_channel_regs(DMA_TX_CHANNEL);
    volatile unsigned int *rx_regs = dma_channel_regs(DMA_RX_CHANNEL);

    spi[SPI_CS_REG   / 4] &= ~SPI_CS_TA;
    spi[SPI_CS_REG   / 4] |= SPI_CS_CLEAR_TX | SPI_CS_CLEAR_RX | SPI_CS_DMAEN;
    spi[SPI_DC_REG   / 4]  = SPI_DMA_THRESHOLDS;
    spi[SPI_DLEN_REG / 4]  = chunk->length;

    dma_reset_channel(DMA_TX_CHANNEL);
    dma_reset_channel(DMA_RX_CHANNEL);

    tx_regs[DMA_REG_CONBLK_AD /4] = 0xc0000000 | chunk->tx_cb_physical;
    rx_regs[DMA_REG_CONBLK_AD /4] = 0xc0000000 | chunk->rx_cb_physical;

    tx_regs[DMA_REG_DEBUG /4]  = DMA_DEBUG_CLEAR;
    tx_regs[DMA_REG_CS    /4] |= DMA_CS_END | DMA_CS_ERROR;
    tx_regs[DMA_REG_CS    /4] |= DMA_PRIORITY | DMA_PANIC_PRIORITY |
                                  DMA_CS_WAIT_FOR_OUTSTANDING_WRITES;

    rx_regs[DMA_REG_DEBUG /4]  = DMA_DEBUG_CLEAR;
    rx_regs[DMA_REG_CS    /4] |= DMA_CS_END | DMA_CS_ERROR;
    rx_regs[DMA_REG_CS    /4] |= DMA_PRIORITY | DMA_PANIC_PRIORITY |
                                  DMA_CS_WAIT_FOR_OUTSTANDING_WRITES;

    spi[SPI_CS_REG /4] |= SPI_CS_TA;

    tx_regs[DMA_REG_CS /4] |= DMA_CS_ACTIVE;
    rx_regs[DMA_REG_CS /4] |= DMA_CS_ACTIVE;

    bool timed_out = false;
    unsigned timeout = _swi(OS_ReadMonotonicTime, _RETURN(0)) + 25;

    while ((tx_regs[DMA_REG_CS /4] & DMA_CS_END) == 0
           || (rx_regs[DMA_REG_CS /4] & DMA_CS_END) == 0
           || (spi[SPI_CS_REG /4] & SPI_CS_DONE) == 0) {
        if (_swi(OS_ReadMonotonicTime, _RETURN(0)) >= timeout) {
            timed_out = true;
            break;
        }
    }

    spi[SPI_CS_REG /4] &= ~SPI_CS_TA;
    spi[SPI_CS_REG /4] |=  SPI_CS_DONE;
    spi[SPI_CS_REG /4] |=  SPI_CS_CLEAR_TX | SPI_CS_CLEAR_RX;


//    printf("SPI DMA chunk %s (%u bytes)\n",
//           (timed_out ? "TIMEOUT" : "completed"),
//           chunk->length);
//    dma_log_transfer_status(spi, tx_regs, rx_regs);

    if (timed_out)
        return lcddisplay_make_lcd_error("SPI DMA transfer timed out");
    if ((tx_regs[DMA_REG_CS /4] & DMA_CS_ERROR) != 0 ||
        (rx_regs[DMA_REG_CS /4] & DMA_CS_ERROR) != 0)
        return lcddisplay_make_lcd_error("SPI DMA transfer failed");
    return NULL;
}

static _kernel_oserror *dma_run_frame_transfer(dma_buffer_t *buffer)
{
    _kernel_oserror *e;

    dma_transfer_chunk_t chunks[DMA_SPI_MAX_CHUNKS];
    unsigned chunk_count = 0;

    e = dma_build_chunks(buffer, chunks, &chunk_count);
    if (e != NULL)
        return e;

    barrier_W();

    int chunk_index;
    for (chunk_index = 0; e == NULL && chunk_index < chunk_count;
         chunk_index++) {
        // printf("Chunk %d of %d\n", chunk_index+1, chunk_count);
        e = dma_run_chunk(&chunks[chunk_index]);
    }

    return e;
}

_kernel_oserror *lcddisplay_dma_prepare(void)
{
    dma_reset_channel(DMA_TX_CHANNEL);
    dma_reset_channel(DMA_RX_CHANNEL);
    return NULL;
}

/* Initialisation table. Each entry is a command byte followed by
 * the number ofparameters and the parameter values. These are stored as
 * words rather than bytes due to the way the SPI FIFO works.
 */
typedef struct {
    int cmd;
    int nparams;
    int params[16];
} lcd_init_cmd_t;

static const lcd_init_cmd_t lcd_init_table[] = {
    { 0x36, 1,  { MADCTL_MY | MADCTL_MV | MADCTL_BGR } }, // MADCTL
    { 0x3A, 1,  { COLMOD_65K_RGB | COLMOD_16BPP } }, // COLMOD
    { 0x2A, 4,  { 0x00, 0x00, 0x01, 0x3F } }, // CASET: 0..319 column window
    { 0x2B, 4,  { 0x00, 0x00, 0x00, 0xEF } }, // RASET: 0..239 row window
    { 0xB2, 5,  { 0x0C, 0x0C, 0x00, 0x33, 0x33 } }, // PORCH
    { 0xB7, 1,  { 0x35 } }, // GCTRL
    { 0xBB, 1,  { 0x1F } }, // VCOMS
    { 0xC0, 1,  { 0x2C } }, // LCMCTL
    { 0xC2, 1,  { 0x01 } }, // VDVVRHEN
    { 0xC3, 1,  { 0x12 } }, // VRHS
    { 0xC4, 1,  { 0x20 } }, // VDVS
    { 0xC6, 1,  { 0x2F } }, // FRCTRL2
    { 0xD0, 2,  { 0xA4, 0xA1 } }, // PWCTRL1
    { 0xE0, 14, { 0xD0, 0x08, 0x11, 0x08, 0x0C, 0x15, 0x39, 0x33,
                  0x50, 0x36, 0x13, 0x14, 0x29, 0x2D } }, // PGAMCTRL
    { 0xE1, 14, { 0xD0, 0x08, 0x10, 0x08, 0x06, 0x06, 0x39, 0x44,
                  0x51, 0x0B, 0x16, 0x14, 0x2F, 0x31 } }, // NGAMCTRL
    { 0x21, 0,  { 0 } }, // INVON
};

#define LCD_INIT_TABLE_LEN (sizeof(lcd_init_table) / sizeof(lcd_init_table[0]))

void lcd_command(int cmd, const int *start, const int *end)
{
    gpio_base[GPIO_GPCLR0_REG/4] = (1 << PIN_DC); // Set DC low
    barrier_W();

    // Send the command
    spi_base[SPI_CS_REG  /4] |= (SPI_CS_CLEAR_TX | SPI_CS_CLEAR_RX | SPI_CS_TA);
    spi_base[SPI_FIFO_REG/4]  = cmd;

    unsigned int timeout = _swi(OS_ReadMonotonicTime, _RETURN(0)) + 25;

    while ((spi_base[SPI_CS_REG/4] & SPI_CS_DONE) == 0) {
        if (_swi(OS_ReadMonotonicTime, _RETURN(0)) > timeout) {
            // Timeout occurred
            printf("SPI command 0x%02X timeout\n", cmd);
            break;
        }
  }

  while ((spi_base[SPI_CS_REG/4] & SPI_CS_RXD) != 0) {
    // Clear any received data
    (void) spi_base[SPI_FIFO_REG/4];
  }

  // Set DC high
  gpio_base[GPIO_GPSET0_REG/4] = (1 << PIN_DC); // Set DC high
  barrier_W();

  // Send the params. We can assume they will all fit in the FIFO.
  const int *param = start;
  while (param < end) {
    spi_base[SPI_FIFO_REG/4] = *param++;
  }

  spi_base[SPI_CS_REG/4] |= SPI_CS_TA;

  timeout = _swi(OS_ReadMonotonicTime, _RETURN(0)) + 25;
  while ((spi_base[SPI_CS_REG/4] & SPI_CS_DONE) == 0) {
    if (_swi(OS_ReadMonotonicTime, _RETURN(0)) > timeout) {
      // Timeout occurred
      printf("SPI parameter 0x%02X timeout\n", *(param-1));
      break;
    }
  }

  while ((spi_base[SPI_CS_REG/4] & SPI_CS_RXD) != 0) {
    // Clear any received data
    (void) spi_base[SPI_FIFO_REG/4];
  }
  // spi_send(cmd, start, end, &ws->hw);
}

void lcd_reset(void)
{
    gpio_base[GPIO_GPSET0_REG/4] = (1 << PIN_CS);
    barrier_W(); sleep(1);         /* 0.010s */
    gpio_base[GPIO_GPSET0_REG/4] = (1 << PIN_RST);
    barrier_W(); sleep(1);          /* 0.005s -> rounds to 1 centisecond */
    gpio_base[GPIO_GPCLR0_REG/4] = (1 << PIN_RST);
    barrier_W(); sleep(2);          /* 0.020s */
    gpio_base[GPIO_GPSET0_REG/4] = (1 << PIN_RST);
    barrier_W(); sleep(15);         /* 0.150s */
    gpio_base[GPIO_GPCLR0_REG/4] = (1 << PIN_CS);
}

_kernel_oserror *lcd_setup(void)
{
    unsigned int i;
    lcd_command(0x11, 0, 0); // SLPOUT
    sleep(15);               // 0.15s

    for (i = 0; i < LCD_INIT_TABLE_LEN; i++) {
        const lcd_init_cmd_t *e = &lcd_init_table[i];
        lcd_command(e->cmd, e->params, e->params + e->nparams);
    }

    lcd_command(0x29, 0, 0); // DISPON

    return NULL;
}

_kernel_oserror *lcd_set_backlight(int enabled)
{
    if (enabled)
        gpio_base[GPIO_GPSET0_REG/4] = (1 << PIN_BL); // Set backlight high
    else
        gpio_base[GPIO_GPCLR0_REG/4] = (1 << PIN_BL); // Set backlight low
    barrier_W();
    return NULL;
}

_kernel_oserror *lcd_show_sprite(void *sprite_ptr)
{
    _kernel_oserror *e;
    dma_buffer_t buffer;

    e  = create_buffer(&buffer);
    if (e) return e;

    if (sprite_ptr) {
      uint16_t *s = (uint16_t*)sprite_ptr + 22; // 44 bytes
      uint16_t *t = (uint16_t*)buffer.tx.logical;

      int i;
      for (i = 0; i < SCREEN_WIDTH * SCREEN_HEIGHT; ++i) {
          // Swap bytes for endianness
          t[i] = (s[i] & 0x00ff) << 8 | (s[i] & 0xff00) >> 8;
      }
    }
    else {
      // No sprite passed, so set to zero (black)
      memset(buffer.tx.logical, 0, SCREEN_WIDTH * SCREEN_HEIGHT * SCREEN_DEPTH);
    }

    lcd_command(0x2c, 0, 0); // RAMWR

    e = dma_run_frame_transfer(&buffer);

    _kernel_oserror *e2 = remove_buffer(&buffer);

    return e ? e : e2;
}
