/* command.c - the *SPIScreenLoad / *SPIScreenOff / *SPIScreenOn star command
 * surface. *SPIScreenLoad loads a sprite file into a fresh single-sprite
 * area and, if (and only if) it is exactly a 320x240 sprite in the
 * panel's native 16bpp mode, displays it. The backlight commands map to
 * the panel's BL GPIO, with *SPIScreenOn refusing to light a panel that
 * has not yet had a real image loaded.
 */

#include <string.h>
#include <stdlib.h>
#include <stdio.h>

#include "kernel.h"
#include "swis.h"

#include "spiscreen.h"
#include "lcd.h"
#include "SPIScreenHdr.h"

/* OS_SpriteOp reason codes used here (see PRM 5a-90ff):
 *   9   ReadSpriteInfo   - width/height (pixels), mask flag, mode word
 *   10  LoadSpriteFile   - load every sprite in a file into an area
 * "+512" selects the "by area pointer and pointer to sprite" register form. */
#define SPRITEOP_READINFO  (512 + 40)
#define SPRITEOP_LOADFILE  (512 + 10)

static _kernel_oserror spiscreen_error;

static _kernel_oserror *spiscreen_make_error(const char *text)
{
    spiscreen_error.errnum = 0x82ec00; /* arbitrary module-local error number */
    strncpy(spiscreen_error.errmess, text, sizeof(spiscreen_error.errmess) - 1);
    spiscreen_error.errmess[sizeof(spiscreen_error.errmess) - 1] = '\0';
    return &spiscreen_error;
}

static _kernel_oserror *spiscreen_load(const char *arg_string, int argc, spiscreen_ws *ws, void *pw)
{
    _kernel_oserror *e;
    _kernel_swi_regs r;
    int width, height, mode;

    if (argc < 1 || arg_string == NULL || arg_string[0] == '\0')
        return spiscreen_make_error("Syntax: *SPIScreenLoad <sprite file>");

    const char *filename = arg_string;
    unsigned length, type;
    e = _swix(OS_File, _INR(0,1)|_OUT(4)|_OUT(6), 23, filename, &length, &type);
    if (e) return e;

    void *sprite_area = malloc(length);

    printf("Len: %d, type: %x\n", length, type);

    r.r[0] = SPRITEOP_LOADFILE;
    r.r[1] = (int) sprite_area;
    r.r[2] = (int) arg_string;
    e = _kernel_swi(OS_SpriteOp, &r, &r);
    if (e != NULL) {
        return e;
    }

    if (((int *) sprite_area)[1] < 1) {
        return spiscreen_make_error("Sprite file must contain a sprite");
    }

    r.r[0] = SPRITEOP_READINFO;
    r.r[1] = (int) sprite_area;
    r.r[2] = r.r[1] + 16;             /* first sprite in the area */
    e = _kernel_swi(OS_SpriteOp, &r, &r);
    if (e != NULL) {
        return e;
    }

    width  = r.r[3];
    height = r.r[4];
    mode   = r.r[6];

    printf("%d x %d mode %x\n", width, height, mode);

    if (width != SCREEN_WIDTH || height != SCREEN_HEIGHT
        || (mode & 0x78000000) != 0x50000000) {
        return spiscreen_make_error(
            "Sprite must be 320x240 pixels, 16bpp (64k)");
    }

    /* offset to first sprite is area word 2 (see spiscreen_reset_spritearea) */
    void *sprite_ptr = (char *) sprite_area + ((int *) sprite_area)[2];

    e = lcd_build(ws, sprite_ptr);
    if (e != NULL)
      return e;

    e = lcd_update(ws, pw);
    if (e != NULL)
        return e;

    free(sprite_area);

    return e;
}

_kernel_oserror *spiscreen_command(const char *arg_string, int argc, int cmd_no, void *pw)
{
    spiscreen_ws *ws = spiscreen_workspace;

    (void) pw;

    if (ws == NULL)
        return spiscreen_make_error("SPIScreen has not initialised correctly");

    switch (cmd_no) {
    case CMD_SPIScreenLoad:
        return spiscreen_load(arg_string, argc, ws, pw);

    case CMD_SPIScreenOff:
        return lcd_set_backlight(ws, 0);

    case CMD_SPIScreenOn:
        return lcd_set_backlight(ws, 1);

    default:
        return spiscreen_make_error("Unknown SPIScreen command");
    }
}
