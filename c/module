#define GPIO_WriteMode 0x58f90
#define GPIO_WriteData 0x58f81

// Two DMA buffers, plus 4K for control blocks
#define DA_SIZE ((2*320*240*2)+4096)

void (*barrier_W)(void);
void (*barrier_R)(void);

/* ARMop 17: clean a virtual address range to the Point of Coherency.
 * Called before DMA reads to flush write-back cache lines to physical RAM. */
void (*cache_clean_range)(const void *start, const void *end);

static void *align_pointer(void *ptr, unsigned int alignment)
{
    unsigned int value = (unsigned int) ptr;

    value = (value + alignment - 1) & ~(alignment - 1);
    return (void *) value;
}

spiscreen_ws *spiscreen_workspace = NULL;

/* Thin wrappers around OS_Module 6/7 (Claim/Free) - used instead of
 * malloc()/free() so the module doesn't depend on the C library heap
 * being wired up for RMA use. */
static _kernel_oserror *claim_memory(int size, void **out)
{
    _kernel_oserror *e;
    _kernel_swi_regs r;

    r.r[0] = 6;
    r.r[3] = size;
    e = _kernel_swi(OS_Module, &r, &r);
    if (e != NULL)
        return e;

    *out = (void *) r.r[2];
    return NULL;
}

static void free_memory(void *ptr)
{
    _kernel_swi_regs r;

    if (ptr == NULL)
        return;

    r.r[0] = 7;
    r.r[2] = (int) ptr;
    (void) _kernel_swi(OS_Module, &r, &r);
}

/* Map the GPIO and SPI0 peripheral registers into the module's address
 * space, as PROCinitGPIO's "SYS OS_Memory,13,..." calls did. */
static _kernel_oserror *map_registers(spiscreen_ws *ws)
{
    _kernel_oserror *e;
    _kernel_swi_regs r;

    r.r[0] = 13;
    r.r[1] = (int) GPIO_PHYS_BASE;
    r.r[2] = GPIO_SPI_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    ws->hw.gpio_base = (void *) r.r[3];

    r.r[0] = 13;
    r.r[1] = (int) SPI_PHYS_BASE;
    r.r[2] = GPIO_SPI_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    ws->hw.spi_base = (void *) r.r[3];

    r.r[0] = 13;
    r.r[1] = (int) DMA_PHYS_BASE;
    r.r[2] = DMA_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    ws->hw.dma_base = (void *) r.r[3];

    return NULL;
}

/* Create a fresh, empty, single-sprite sprite area of exactly the size
 * required for one 320x240 16bpp sprite (matches the original DIM'd
 * spritearea% initialisation). */
void spiscreen_reset_spritearea(spiscreen_ws *ws)
{
    int *area = (int *) ws->spritearea;

    memset(ws->spritearea, 0x00, SPRITE_AREA_SIZE);

    area[0] = SPRITE_AREA_SIZE;   /* total area size */
    area[1] = 0;                  /* number of sprites */
    area[2] = 16;                 /* offset to first sprite */
    area[3] = 16;                 /* offset to first free word */
}

