/* module.c - module lifetime: initialisation, finalisation, and the
 * hardware bring-up that was previously done at the top level of the
 * BASIC program (buffer allocation, GPIO/SPI register mapping, and
 * PROCinitGPIO).
 *
 * The module keeps a single, static workspace instance (lcddisplay_ws) -
 * this mirrors the original program's single set of global variables and
 * keeps things simple, since the hardware this module drives is a single
 * physical SPI LCD; the module is not designed to be multiply
 * instantiated.
 */

#include <string.h>
#include <stdio.h>

#include "kernel.h"
#include "swis.h"
#include "Global/OSMisc.h"

#include "SPIDefs.h"
#include "lcddisplay.h"
#include "lcd.h"

#include "LCDDisplayHdr.h"

void (*barrier_W)(void);
void (*barrier_R)(void);

volatile unsigned *gpio_base;
volatile unsigned *spi_base;
volatile unsigned *dma_base;

/* Map in the GPIO and SPI0 peripheral registers */
static _kernel_oserror *map_registers(void)
{
    _kernel_oserror *e;
    _kernel_swi_regs r;

    r.r[0] = 13;
    r.r[1] = (int) GPIO_PHYS_BASE;
    r.r[2] = GPIO_SPI_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    gpio_base = (volatile uint32_t *) r.r[3];

    r.r[0] = 13;
    r.r[1] = (int) SPI_PHYS_BASE;
    r.r[2] = GPIO_SPI_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    spi_base = (volatile uint32_t *) r.r[3];

    r.r[0] = 13;
    r.r[1] = (int) DMA_PHYS_BASE;
    r.r[2] = DMA_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    dma_base = (volatile uint32_t *) r.r[3];

    return NULL;
}

_kernel_oserror *hw_init(void)
{
    // GPFSEL0: GPIO 7, 8, 9 -> ALT0 (SPI0)
    gpio_base[GPIO_GPFSEL0_REG/4] =
        gpio_base[GPIO_GPFSEL0_REG/4] & 0x249fffff | 0x24800000;
    // GPFSEL1: GPIO 10, 11 -> ALT0 (SPI0)
    gpio_base[GPIO_GPFSEL1_REG/4] =
        gpio_base[GPIO_GPFSEL1_REG/4] & 0x2fffffe4 | 0x00000024;

    int output_pins[] = {PIN_BL, PIN_DC, PIN_RST};
    int i;

    for (i = 0; i < sizeof(output_pins) / sizeof(int); ++i) {
      int pin = output_pins[i];
      int reg = pin / 10;
      int shift = (pin - (reg * 10)) * 3;
      unsigned mask = ~(7 << shift);
      unsigned set  = 1 << shift;

      gpio_base[reg] = gpio_base[reg] & mask | set;

      //printf("Set pin %d as output (reg: %d shift:%d mask:%x set:%x)\n", pin, reg, shift, mask, set);
    }

    // Setup output pins
//    lcddisplay_gpio_write_mode(PIN_BL, 1);
    // lcddisplay_gpio_write_mode(PIN_CS, 1);
//    lcddisplay_gpio_write_mode(PIN_DC, 1);
//    lcddisplay_gpio_write_mode(PIN_RST, 1);

    spi_base[SPI_CS_REG /4] = SPI_CS_CPHA | SPI_CS_CPOL |
                              SPI_CS_CLEAR_TX | SPI_CS_CLEAR_RX;
    spi_base[SPI_CLK_REG/4] = SPI_CLOCK_DIV;

  barrier_W();
  return 0;
}

_kernel_oserror *module_init(const char *cmd_tail, int podule_base, void *pw)
{
    _kernel_oserror *e;

    (void) cmd_tail;
    (void) podule_base;
    (void) pw;

    e = _swix(OS_MMUControl, _IN(0) | _OUT(0),
              MMUCReason_GetARMop + (ARMop_DMB_Write << 8), &barrier_W);
    if (e) return e;

    e = _swix(OS_MMUControl, _IN(0) | _OUT(0),
              MMUCReason_GetARMop + (ARMop_DMB_Read << 8), &barrier_R);
    if (e) return e;

    e = map_registers();
    if (e != NULL)
        goto fail;

    e = hw_init();
    if (e != NULL)
        goto fail;

    e = lcd_set_backlight(0);
    if (e != NULL)
      goto fail;

    e = lcddisplay_dma_prepare();
    if (e != NULL)
        goto fail;

    lcd_reset();
    e = lcd_setup();
    if (e != NULL)
        goto fail;

    return lcd_show_sprite(0);

fail:
    // module_final(1, podule_base, pw);
    return e;
}

_kernel_oserror *module_final(int fatal, int podule_base, void *pw)
{
    (void) fatal;
    (void) podule_base;
    (void) pw;

    return NULL;
}

void sleep(int centiseconds)
{
    _kernel_swi_regs r;
    int target;

    (void) _kernel_swi(OS_ReadMonotonicTime, &r, &r);
    target = r.r[0] + centiseconds;

    do {
        (void) _kernel_swi(OS_ReadMonotonicTime, &r, &r);
    } while (r.r[0] < target);
}
