/* module.c - module lifetime: initialisation, finalisation, and the
 * hardware bring-up that was previously done at the top level of the
 * BASIC program (buffer allocation, GPIO/SPI register mapping, and
 * PROCinitGPIO).
 *
 * The module keeps a single, static workspace instance (spiscreen_ws) -
 * this mirrors the original program's single set of global variables and
 * keeps things simple, since the hardware this module drives is a single
 * physical SPI LCD; the module is not designed to be multiply
 * instantiated.
 */

#include <string.h>
#include <stdio.h>

#include "kernel.h"
#include "swis.h"
#include "Global/OSMisc.h"

#include "SPIDefs.h"
#include "spiscreen.h"
#include "lcd.h"

#include "SPIScreenHdr.h"

#define GPIO_WriteMode 0x58f90
#define GPIO_WriteData 0x58f81

// Two DMA buffers, plus 4K for control blocks
#define DA_SIZE ((2*320*240*2)+4096)

void (*barrier_W)(void);
void (*barrier_R)(void);

spiscreen_ws *spiscreen_workspace = NULL;

/* Thin wrappers around OS_Module 6/7 (Claim/Free) - used instead of
 * malloc()/free() so the module doesn't depend on the C library heap
 * being wired up for RMA use. */
static _kernel_oserror *claim_memory(int size, void **out)
{
    _kernel_oserror *e;
    _kernel_swi_regs r;

    r.r[0] = 6;
    r.r[3] = size;
    e = _kernel_swi(OS_Module, &r, &r);
    if (e != NULL)
        return e;

    *out = (void *) r.r[2];
    return NULL;
}

static void free_memory(void *ptr)
{
    _kernel_swi_regs r;

    if (ptr == NULL)
        return;

    r.r[0] = 7;
    r.r[2] = (int) ptr;
    (void) _kernel_swi(OS_Module, &r, &r);
}

/* Map the GPIO and SPI0 peripheral registers into the module's address
 * space, as PROCinitGPIO's "SYS OS_Memory,13,..." calls did. */
static _kernel_oserror *map_registers(spiscreen_ws *ws)
{
    _kernel_oserror *e;
    _kernel_swi_regs r;

    r.r[0] = 13;
    r.r[1] = (int) GPIO_PHYS_BASE;
    r.r[2] = GPIO_SPI_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    ws->hw.gpio_base = (volatile uint32_t *) r.r[3];

    r.r[0] = 13;
    r.r[1] = (int) SPI_PHYS_BASE;
    r.r[2] = GPIO_SPI_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    ws->hw.spi_base = (volatile uint32_t *) r.r[3];

    r.r[0] = 13;
    r.r[1] = (int) DMA_PHYS_BASE;
    r.r[2] = DMA_MAP_SIZE;
    e = _kernel_swi(OS_Memory, &r, &r);
    if (e != NULL)
        return e;
    ws->hw.dma_base = (volatile uint32_t *) r.r[3];

    return NULL;
}

_kernel_oserror *hw_init(spiscreen_ws *ws)
{
  ws->hw.gpio_base[0] = ws->hw.gpio_base[0] & 0x249fffff | 0x24800000; // GPSEL0
  ws->hw.gpio_base[1] = ws->hw.gpio_base[1] & 0x2fffffe4 | 0x00000024; // GPSEL1

  ws->hw.gpio_base[0x1c/4] = 2 << 6;
  ws->hw.gpio_base[0x28/4] = 7 << 9;

  ws->hw.spi_base[SPI_CS_REG /4] = SPI_CS_CPHA | SPI_CS_CPOL |
                                   SPI_CS_CLEAR_TX | SPI_CS_CLEAR_RX;
  ws->hw.spi_base[SPI_CLK_REG/4] = 8;

  return 0;
}

_kernel_oserror *module_init(const char *cmd_tail, int podule_base, void *pw)
{
    _kernel_oserror *e;
    spiscreen_ws *ws;

    (void) cmd_tail;
    (void) podule_base;
    (void) pw;

    e = _swix(OS_MMUControl, _IN(0) | _OUT(0),
              MMUCReason_GetARMop + (ARMop_DMB_Write << 8), &barrier_W);
    if (e) return e;

    e = _swix(OS_MMUControl, _IN(0) | _OUT(0),
              MMUCReason_GetARMop + (ARMop_DMB_Read << 8), &barrier_R);
    if (e) return e;

    e = claim_memory(sizeof(*ws), (void **) &ws);
    if (e != NULL)
        return e;

    memset(ws, 0, sizeof(*ws));

    e = _swix(PCI_RAMAlloc, _INR(0,2)|_OUTR(0,1), 320*240*2, 0x1000, 0, &ws->pci_logical, &ws->pci_physical);

    e = _swix(PCI_RAMAlloc, _INR(0,2)|_OUTR(0,1), DMA_MAX_CONTROL_BLOCKS*DMA_CB_SIZE, 0x1000, 0, &ws->cb_logical, &ws->cb_physical);

    memset(ws->pci_logical, 0, 320*240*2);

    spiscreen_workspace = ws;
    e = _swix(OS_DynamicArea, _INR(0,8)|_OUT(1)|_OUT(3),
                      0, -1, DA_SIZE, -1, 1<<4|1<<5|1<<7, DA_SIZE, 0, 0, "LCD Screen Data", &ws->da_number, &ws->da_base);
    if (e) return e;

/*
    e = claim_memory(DMA_BUFFER_SIZE + DMA_BUFFER_ALIGNMENT - 1,
                     &ws->dmabuffer_raw);
    if (e != NULL)
        goto fail;
*/
    ws->dma_tx_buffer = (void*)ws->da_base;//align_pointer(ws->dmabuffer_raw, DMA_BUFFER_ALIGNMENT);

/*    e = claim_memory(DMA_BUFFER_SIZE + DMA_BUFFER_ALIGNMENT - 1,
                     &ws->dma_rxbuffer_raw);
    if (e != NULL)
        goto fail;
*/
    ws->dma_rx_buffer = (void*)(ws->da_base+320*240*2);//align_pointer(ws->dma_rxbuffer_raw, DMA_BUFFER_ALIGNMENT);

/*
    e = claim_memory((DMA_MAX_CONTROL_BLOCKS * 32) + DMA_CB_ALIGNMENT - 1,
                     &ws->dma_cb_raw);
    if (e != NULL)
        goto fail;

    ws->dma_cb =  (void*)(ws->da_base+2*320*240*2);//;align_pointer(ws->dma_cb_raw, DMA_CB_ALIGNMENT);
*/

    e = map_registers(ws);
    if (e != NULL)
        goto fail;

    //gpio_hw_init(&ws->hw);

    e = hw_init(ws);
    if (e != NULL)
        goto fail;

    e = spiscreen_dma_prepare(ws);
    if (e != NULL)
        goto fail;

    e = lcd_set_backlight(ws, 0);
    if (e != NULL)
        goto fail;

    e = spiscreen_gpio_write_mode(ws, PIN_CS, 1);
//    if (e == NULL)
//        e = spiscreen_gpio_write_data(ws, PIN_BL, 1);
    if (e == NULL)
        e = spiscreen_gpio_write_mode(ws, PIN_DC, 1);
    if (e == NULL)
        e = spiscreen_gpio_write_mode(ws, PIN_RST, 1);
    if (e != NULL)
        goto fail;

    lcd_reset(ws);
    e = lcd_setup(ws);
    if (e != NULL)
        goto fail;
    e = lcd_set_window(ws, 0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1);
    if (e != NULL)
        goto fail;


    //memset((char*)ws->spriteptr+44, 0, 320*240*2);

    // lcd_build(ws, pw);
    lcd_update(ws, pw);
    lcd_set_backlight(ws, 0);

    if (e != NULL)
        goto fail;

    return NULL;

fail:
    // module_final(1, podule_base, pw);
    return e;
}

_kernel_oserror *module_final(int fatal, int podule_base, void *pw)
{
    spiscreen_ws *ws = spiscreen_workspace;

    (void) fatal;
    (void) podule_base;
    (void) pw;

    if (ws == NULL)
        return NULL;

    _swix(PCI_RAMFree, _IN(0), ws->pci_logical);
    _swix(PCI_RAMFree, _IN(0), ws->cb_logical);
    if (ws->da_number) _swix(OS_DynamicArea, _INR(0,1), 1, ws->da_number);
    free_memory(ws);

    spiscreen_workspace = NULL;
    return NULL;
}
