; spiasm.s - ObjAsm translation of the hand-written SPI/GPIO assembler from
; source.txt (spiSend, lineblt, and the assembler half of PROCinitGPIO).
;
; These were originally assembled at run time by BBC BASIC's inline
; assembler into a DIM'd scratch buffer, and called via CALL/USR with
; arguments passed through the A%-F% pseudo-registers. Here they are
; ordinary APCS-conforming functions, compiled once into the module, and
; called directly from C (see h/asm.h). Register roles have been renumbered
; onto the standard argument registers r0-r3. The SPI and GPIO routines
; preserve their original instruction sequences; lineblt is adapted for the
; compact DMA transfer format.
;
; No hardware register addresses are baked into the code: the GPIO/SPI
; register bases are passed in by the caller (via a hw_regs_t*), so this
; object is fully position independent and safe to link into a module.

        AREA    |C$$code|, CODE, READONLY

        EXPORT  spi_send
        EXPORT  lcd_lineblt
        EXPORT  gpio_hw_init

SPI_CLOCK_DIV   *       8

; ---------------------------------------------------------------------
; void spi_send(int cmd, const void *start, const void *end,
;               const hw_regs_t *hw)
;
;   r0 = cmd    - command byte, sent first with D/C held low
;   r1 = start  -> first data word (sent with D/C held high)
;   r2 = end    -> one past the last data word
;   r3 = hw     -> { gpio_base, spi_base }
;
; Clobbers r0-r7; r4-r7 are saved/restored per APCS.
; ---------------------------------------------------------------------
spi_send
        STMFD   sp!, {r4-r7, lr}

        LDR     r6, [r3, #0]            ; r6 = gpio_base
        LDR     r7, [r3, #4]            ; r7 = spi_base
        MOV     r5, r2                  ; r5 = end (data end pointer)

        ;SWI     "OS_EnterOS"

        ; --- D/C low: command phase ---
        MOV     r4, #1
        MOV     r2, r4, LSL #25
        STR     r2, [r6, #40]           ; GPCLR0 - clear D/C pin
        MCR     p15, 0, r6, c7, c10, 5  ; Data Memory Barrier

        ; --- start SPI transfer, flush FIFOs ---
        LDR     r2, [r7, #0]            ; current SPI CS
        AND     r2, r2, #&0c            ; preserve CPHA/CPOL
;        ORR     r2, r2, #&6b0           ; CLEAR_TX|CLEAR_RX|TA|DMAEN|INTD|INTR
        ORR     r2, r2, #&98            ; CLEAR_TX|CLEAR_RX|TA
        STR     r2, [r7, #0]

        MCR     p15, 0, r6, c7, c10, 5
        STR     r0, [r7, #4]            ; write command byte to FIFO

spi_send_cmdwait
        MCR     p15, 0, r6, c7, c10, 5
        LDR     r2, [r7, #0]
        TST     r2, #1<<16              ; DONE?
        BEQ     spi_send_cmdwait
        TST     r2, #1<<17              ; RXD?
        LDRNE   r0, [r7, #4]            ; drain RX FIFO

        ; --- D/C high: data phase ---
        MOV     r4, #1
        MOV     r2, r4, LSL #25
        STR     r2, [r6, #28]           ; GPSET0 - set D/C pin
        MCR     p15, 0, r6, c7, c10, 5

spi_send_isdone
        MOV     r0, r1
        ADD     r0, r0, #64
        CMP     r0, r5
        BHI     spi_send_sendrem

        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        CMP     r1, r5
        BEQ     spi_send_endsend

spi_send_bulk
        MCR     p15, 0, r6, c7, c10, 5
spi_send_busyloop
        LDR     r2, [r7, #0]
        TST     r2, #1<<16              ; DONE - remote end finished early?
        BNE     spi_send_isdone
        TST     r2, #1<<19              ; TXD - room for more?
        BEQ     spi_send_busyloop

        MOV     r0, r1
        ADD     r0, r0, #48
        CMP     r0, r5
        BHI     spi_send_sendrem

        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        LDR     r2, [r7, #4]
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]

        CMP     r1, r5
        BNE     spi_send_bulk

spi_send_sendrem
        CMP     r1, r5
        BEQ     spi_send_endsend
        LDR     r0, [r1], #4
        STR     r0, [r7, #4]
        B       spi_send_sendrem

spi_send_endsend
spi_send_endloop
        MCR     p15, 0, r6, c7, c10, 5
        LDR     r2, [r7, #0]
        TST     r2, #1<<17
        LDRNE   r0, [r7, #4]
        TST     r2, #1<<16
        BEQ     spi_send_endloop

        ORR     r2, r2, #&30
        BIC     r2, r2, #&80
        STR     r2, [r7, #0]

        ;SWI     "OS_LeaveOS"

        LDMFD   sp!, {r4-r7, pc}


; ---------------------------------------------------------------------
; void lcd_lineblt(const void *src, void *dst_start,
;                   const void *dst_end)
;
;   r0 = src           -> source pixel data (16bpp packed, auto-advanced)
;   r1 = dst_start     -> first destination byte
;   r2 = dst_end       -> one past the final destination byte
;
; The original routine expanded each byte into a 32-bit word for its
; CPU-driven SPI path. DMA writes packed FIFO data, so this replacement
; keeps the output compact and only performs the required byte swap within
; each 16bpp pixel.
; ---------------------------------------------------------------------
lcd_lineblt
        STMFD   sp!, {r4, r5}
        MOV     r5, r2                  ; r5 = dst_end

lcd_lineblt_loop
        LDR     r2, [r0], #4            ; r2 = next source word
        MOV     r3, r2, LSR #8
        AND     r3, r3, #&ff            ; first pixel high byte
        AND     r4, r2, #&ff
        ORR     r3, r3, r4, LSL #8      ; first pixel low byte
        MOV     r4, r2, LSR #24
        ORR     r3, r3, r4, LSL #16     ; second pixel high byte
        MOV     r4, r2, LSR #16
        AND     r4, r4, #&ff
        ORR     r3, r3, r4, LSL #24     ; second pixel low byte
        STR     r3, [r1], #4

        CMP     r1, r5
        BLO     lcd_lineblt_loop

        LDMFD   sp!, {r4, r5}
        MOV     pc, lr


; ---------------------------------------------------------------------
; void gpio_hw_init(const hw_regs_t *hw)
;
; Configures the GPIO alternate function selects for the SPI0 pins and
; the SPI0 CS/clock-divider registers. Direct port of the assembler half
; of PROCinitGPIO; the GPIO_WriteMode/GPIO_WriteData SWI calls that
; originally followed it now live in C (see c/module.c).
;
;   r0 = hw -> { gpio_base, spi_base }
; ---------------------------------------------------------------------
gpio_hw_init
        STMFD   sp!, {r4, lr}
        LDR     r4, [r0, #0]            ; r4 = gpio_base
        LDR     r1, [r0, #4]            ; r1 = spi_base

        ;SWI     "OS_EnterOS"

        LDR     r2, gpio_hw_init_gpsel0_or
        LDR     r3, [r4, #0]
        ORR     r3, r3, r2
        LDR     r2, gpio_hw_init_gpsel0_and
        AND     r3, r3, r2
        STR     r3, [r4, #0]

        LDR     r2, gpio_hw_init_gpsel1_or
        LDR     r3, [r4, #4]
        ORR     r3, r3, r2
        LDR     r2, gpio_hw_init_gpsel1_and
        AND     r3, r3, r2
        STR     r3, [r4, #4]

        MOV     r2, #3 :SHL: 6
        STR     r2, [r4, #&1c]

        MOV     r2, #7 :SHL: 9
        STR     r2, [r4, #&28]

        MOV     r2, #&3C
        STR     r2, [r1, #0]

        MOV     r2, #SPI_CLOCK_DIV
        STR     r2, [r1, #&8]

        ;SWI     "OS_LeaveOS"

        LDMFD   sp!, {r4, pc}

gpio_hw_init_gpsel0_or   DCD  &24800000
gpio_hw_init_gpsel0_and  DCD  &249fffff
gpio_hw_init_gpsel1_or   DCD  &00000024
gpio_hw_init_gpsel1_and  DCD  &2fffffe4

        END
