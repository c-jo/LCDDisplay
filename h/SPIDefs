#ifndef SPIDEFS_H
#define SPIDEFS_H

// SPI Registers
#define SPI_CS_REG   0x00
#define SPI_FIFO_REG 0x04
#define SPI_CLK_REG  0x08
#define SPI_DLEN_REG 0x0C
#define SPI_DC_REG   0x14

// CS Bits
#define SPI_CS_CS       (0) // 2 bits
#define SPI_CS_CPHA     (1u << 2)
#define SPI_CS_CPOL     (1u << 3)
#define SPI_CS_CLEAR_TX (1u << 4)
#define SPI_CS_CLEAR_RX (1u << 5)
#define SPI_CS_CSPOL    (1u << 6)
#define SPI_CS_TA       (1u << 7)
#define SPI_CS_DMAEN    (1u << 8)
#define SPI_CS_DONE     (1u << 16)
#define SPI_CS_RXD      (1u << 17)
#define SPI_CS_TXD      (1u << 18)

// GPIO Registers
#define GPIO_GPFSEL0_REG 0x00
#define GPIO_GPFSEL1_REG 0x04
#define GPIO_GPFSEL2_REG 0x08
#define GPIO_GPFSEL3_REG 0x0C
#define GPIO_GPFSEL4_REG 0x10
#define GPIO_GPFSEL5_REG 0x14
#define GPIO_GPSET0_REG 0x1C
#define GPIO_GPSET1_REG 0x20
#define GPIO_GPCLR0_REG 0x28
#define GPIO_GPCLR1_REG 0x2C

// PWM Registers
#define PWM_CTL_REG  0x00
#define PWM_STA_REG  0x04
#define PWM_DMAC_REG 0x08
#define PWM_RNG1_REG 0x10
#define PWM_DAT1_REG 0x14
#define PWM_FIF1_REG 0x18
#define PWM_RNG2_REG 0x20
#define PWM_DAT2_REG 0x24

// PWM CTL Bits
#define PWM_CTL_PWEN1   (1u << 0)
#define PWM_CTL_MODE1   (1u << 1)
#define PWM_CTL_RPTL1   (1u << 2)
#define PWM_CTL_SBIT1   (1u << 3)
#define PWM_CTL_POLA1   (1u << 4)
#define PWM_CTL_USEF1   (1u << 5)
#define PWM_CTL_CLRF1   (1u << 6)
#define PWM_CTL_MSEN1   (1u << 7)
#define PWM_CTL_PWEN2   (1u << 8)

// Clock Manager Registers (PWM Clock)
#define CM_PWMCTL_REG   0xA0
#define CM_PWMDIV_REG   0xA4
#define CM_PASSWD       0x5A000000u
#define CM_SRC_OSC      1u
#define CM_ENAB         (1u << 4)

#endif
