/* lcd.h - LCD control built on top of the ObjAsm spi_send/lineblt/gpio_hw_init
 * primitives: panel reset, ILI9341 init table, address-window setup, and
 * the sprite-to-DMA-buffer frame update.
 */
#ifndef SPISCREEN_LCD_H
#define SPISCREEN_LCD_H

#include "kernel.h"
#include "spiscreen.h"

/* Send one command byte followed by the (int-per-byte, word-spaced) data
 * words in [start,end). Thin wrapper around spi_send binding in ws->hw. */
void spiscreen_spi(spiscreen_ws *ws, int cmd, const int *start, const int *end);

/* Prepare the DMA-visible address information for the module's permanent
 * TX/RX/control-block buffers. */
_kernel_oserror *spiscreen_dma_prepare(spiscreen_ws *ws);

/* Panel reset sequence (GPIO pulses + delays) - port of PROClcdReset. */
void lcd_reset(spiscreen_ws *ws);

/* Send the ILI9341 initialisation command table and turn the display on -
 * port of PROClcdSetup/PROClcdSendInitData. */
_kernel_oserror *lcd_setup(spiscreen_ws *ws);

/* Drive the panel backlight GPIO high/low. */
_kernel_oserror *lcd_set_backlight(spiscreen_ws *ws, int enabled);

/* Set the ILI9341 column/row address window - port of PROCsetWindow. */
_kernel_oserror *lcd_set_window(spiscreen_ws *ws, int x0, int y0, int x1, int y1);

/* Convert the current sprite into the DMA buffer. */
_kernel_oserror *lcd_build(spiscreen_ws *ws, void *sprite_ptr);

/* Stream the current DBA buffer to the panel - port of PROClcdUpdate. */
_kernel_oserror *lcd_update(spiscreen_ws *ws, void *pw);

#endif /* SPISCREEN_LCD_H */
