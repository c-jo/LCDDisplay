/* spiscreen.h - shared workspace/constants for the SPIScreen module
 *
 * Ported from the original BBC BASIC + inline ARM assembler prototype
 * (source.txt). Phase 1 of the conversion keeps the register-level SPI/GPIO
 * work in ObjAsm (see s/spiasm) and moves everything else into C.
 */
#ifndef SPISCREEN_H
#define SPISCREEN_H

#include "kernel.h"
#include <stdint.h>

/* Physical register bases, mapped once at Init via OS_Memory reason 13 */
#define GPIO_PHYS_BASE   0xFE200000u
#define SPI_PHYS_BASE    0xFE204000u
#define SPI_BUS_BASE     0x7E204000u
#define DMA_PHYS_BASE    0xFE007000u
#define GPIO_SPI_MAP_SIZE 0x100
#define DMA_MAP_SIZE      0x1000

/* GPIO pin assignments (BCM numbering) - board specific, see instructions */
#define PIN_CS   8
#define PIN_BL   18
#define PIN_DC   25
#define PIN_RST  27

/* SPI0 clock divider */
// #define SPI_CLOCK_DIV 4

/* Panel geometry */
#define SCREEN_WIDTH  320
#define SCREEN_HEIGHT 240
#define SCREEN_DEPTH  2

/* 320 * 240 * 16bpp pixel data + 44 byte sprite header + 16 byte area header
 * = 153660, round up  */
#define SPRITE_AREA_SIZE 163840

/* 320 * 240 * 16bpp for the SPI DMA staging buffer */
#define DMA_BUFFER_SIZE (SCREEN_WIDTH * SCREEN_HEIGHT * 2)
#define DMA_BUFFER_ALIGNMENT 4096

/* The BCM2711's general-purpose DMA channels use 32-byte control blocks.
 * Use page alignment for the CB storage so no control block straddles a
 * page boundary when we translate logical -> physical addresses. */
#define DMA_CB_ALIGNMENT 4096
#define DMA_MAX_EXTENTS ((DMA_BUFFER_SIZE / 4096) + 8)
/* Splitting the frame into SPI DLEN-sized transfers can split an extent at
 * each chunk boundary, requiring one additional control block per stream. */
#define DMA_CB_SIZE 32
/* We use the very end of the control block page for the extra word to write at the start of each transfer */

#define DMA_MAX_CONTROL_BLOCKS 32 // Should be plenty (famous last words)
#define DMA_TX_CHANNEL 6
#define DMA_RX_CHANNEL 7

extern void (*barrier_W)(void);
extern void (*barrier_R)(void);
extern void (*cache_clean_range)(const void *start, const void *end);

typedef struct dma_extent {
    unsigned int logical;
    unsigned int physical;
    unsigned int length;
    unsigned int flags;
} dma_extent_t;

/* Pair of mapped register bases, passed to the ObjAsm routines */
typedef struct hw_regs {
    volatile uint32_t *gpio_base;
    volatile uint32_t *spi_base;
    volatile uint32_t *dma_base;
} hw_regs_t;

typedef struct buffers {
  struct {
        void    *logical;
        uint32_t physical;
        size_t   size;
    } tx, rx, cb;
} buffers_t;

/* Module workspace - one instance, pointed to by the module's private word */
typedef struct spiscreen_workspace {
    hw_regs_t hw;

    unsigned pci_physical;
    void*    pci_logical;

    unsigned cb_physical;
    void*    cb_logical;

    dma_extent_t dma_tx_extents[DMA_MAX_EXTENTS];
    dma_extent_t dma_rx_extents[DMA_MAX_EXTENTS];
    dma_extent_t dma_cb_extents[DMA_MAX_EXTENTS];
    int dma_tx_extent_count;
    int dma_rx_extent_count;
    int dma_cb_extent_count;
} spiscreen_ws;

/* Shared helpers, implemented in c/gpio.c */
_kernel_oserror *spiscreen_gpio_write_mode(spiscreen_ws *ws, int pin, int value);
_kernel_oserror *spiscreen_gpio_write_data(spiscreen_ws *ws, int pin, int value);
void spiscreen_sleep(int centiseconds);

/* Implemented in c/module.c */
extern spiscreen_ws *spiscreen_workspace;

#endif /* SPISCREEN_H */
