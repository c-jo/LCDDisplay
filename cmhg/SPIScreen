; SPIScreen.cmhg - CMHG module header.
;
; Defines module identity/help text, the initialisation/finalisation
; entry points (c/module.c), and the *SPIScreenLoad/*SPIScreenOff/
; *SPIScreenOn star command surface in c/command.c.

#include "VersionNum"

initialisation-code: module_init
finalisation-code: module_final

title-string: SPIScreen
help-string: SPIScreen Module_FullVersion_CMHG

command-keyword-table: spiscreen_command
    SPIScreenLoad(min-args: 1, max-args: 1,
                  invalid-syntax: "Syntax: *SPIScreenLoad <sprite file>",
                  help-text: "*SPIScreenLoad <sprite file>\n\
Loads <sprite file> and displays it on the SPI LCD panel. The file must\n\
contain exactly one sprite, 320x240 pixels, in the panel's native 16bpp\n\
mode - anything else is rejected with an error."),
    SPIScreenOff(min-args: 0, max-args: 0,
                 help-text: "*SPIScreenOff\n\
Turns the SPI LCD panel backlight off."),
    SPIScreenOn(min-args: 0, max-args: 0,
                help-text: "*SPIScreenOn\n\
Turns the SPI LCD panel backlight on. Fails unless an image has already\n\
been loaded with *SPIScreenLoad.")
